{
  "name": "react-revolver",
  "version": "2.0.0",
  "description": "Revolving infinite carousel in React",
  "type": "module",
  "main": "./dist/react-revolver.cjs",
  "module": "./dist/react-revolver.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-revolver.js",
      "require": "./dist/react-revolver.cjs"
    },
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulllberg/react-revolver.git"
  },
  "keywords": [
    "react",
    "revolver",
    "infinite",
    "carousel"
  ],
  "author": "Daniel Gullberg",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gulllberg/react-revolver/issues"
  },
  "homepage": "https://github.com/gulllberg/react-revolver#readme",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "files": [
    "dist"
  ]
}
